# Copy to %USERPROFILE%\.agent-bridge\agents.toml and uncomment what you need.
# This file is the machine-local overlay (not the repo default).

# Behind a firewall only. A machine on a direct network needs no proxy;
# a null env.proxy in list_agents is normal there.
# [env.proxy]
# url = "http://127.0.0.1:7897"
# no_proxy = "localhost,127.0.0.1,::1"

# Self-exit for abandoned MCP server instances whose host never closed stdin.
# 7200 is already the default; set 0 to disable. idle_exit_sec only fires on
# an idle server — a queued or running task suppresses it.
# shutdown_policy: "cancel" (default) kills in-flight turns when the host
# closes the MCP transport; "linger" lets them finish first, bounded by
# linger_max_sec (default 86400 = 24 h). Linger only covers an orderly
# shutdown — it cannot defeat a host force-kill of the Bridge process
# tree. To carry a turn across a host restart, park it with pause_task
# and continue it with resume_task on the next Bridge instance.
# remote_tasks (default true) lets check_task / wait_task / get_result /
# list_tasks see tasks a sibling Bridge instance still owns (read-only).
# [server]
# idle_exit_sec = 7200
# shutdown_policy = "cancel"
# linger_max_sec = 86400
# remote_tasks = true

# Cancel a turn whose worker has produced no output for this long (seconds).
# Default 1800; 0 disables. Raise it for a worker that runs long silent
# builds or test suites. The task then ends failed / stop_reason "stalled".
# This is the worker-silence limit — separate from wait_task's timeout_sec
# (per call) and the host MCP tool timeout. A task keeps running whether or
# not anyone is waiting; see "Waiting and timeouts" in SETUP.md.
# [agents.grok]
# stall_timeout_sec = 3600

# Dispatch policy: mode = manual | auto | eager (default auto).
# instructions is free text the coordinator reads via list_agents; it
# overrides the default worker split and persists across sessions.
# [coordinator]
# mode = "auto"
# instructions = """Research goes to antigravity. Coding goes to grok.
# Long single-file ports go to kimi (k3-256k)."""

# Remaining quota returned with each list_agents row (agents[].quota).
# Bridge only reports it; routing stays with the coordinator and your
# instructions. Workers Bridge cannot query answer status = "unknown".
# Custom API/auth endpoints are unsupported; cache expires at window reset.
# DSH balance lookup is unsupported.
# experimental = true also reads the private endpoints Grok Build's and
# Claude Code's own /usage commands call (OAuth login only).
# [quota]
# enabled = true
# timeout_sec = 4
# cache_sec = 300
# experimental = false

# Optional. Only if a worker actually reads that variable from the process
# environment. DSH credentials usually live in ~/.dsh/.credentials.yaml.
# [env.set]
# DEEPSEEK_API_KEY = "do-not-commit"

# [agents.grok.env]
# HTTPS_PROXY = "http://127.0.0.1:7897"

# OpenCode: no product login. Connect providers with `opencode auth`
# (official Zen / Go, or any API-key provider). Optional passthrough:
# [env.set]
# OPENCODE_API_KEY = "do-not-commit"

# Kimi: auth lives in ~/.kimi-code (run `kimi login` once), not in an env var.
# Only pin these when the defaults are wrong for this machine:
# [agents.kimi.env]
# KIMI_CODE_HOME = "D:/kimi-code"
# KIMI_SHELL_PATH = "C:/Program Files/Git/bin/bash.exe"

# Claude Code: product `claude` is not ACP. Install the adapter and log in:
#   npm install -g @agentclientprotocol/claude-agent-acp @anthropic-ai/claude-code
#   claude auth login
# Gateway / OpenRouter (optional) — ANTHROPIC_API_KEY must stay empty:
# [env.set]
# ANTHROPIC_BASE_URL = "https://openrouter.ai/api"
# ANTHROPIC_AUTH_TOKEN = "do-not-commit"
# CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY = "1"
# OPENROUTER_API_KEY is also inherited; if ANTHROPIC_AUTH_TOKEN is unset,
# Bridge copies it and defaults the base URL to OpenRouter.

# DSH: do not put a personal checkout path in the repo agents.toml.
# Optional overrides live here or in the process environment:
# DSH_ACP_BIN = "C:/path/to/dsh-acp-demo/lib/bin.js"
# DSH_HARNESS = "C:/src/deepseek-harness"
